{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y jev-use@0.8.0 hook gate",
            "timeout": 30,
            "statusMessage": "Jev gate: risk-checking this action"
          }
        ]
      }
    ]
  }
}
