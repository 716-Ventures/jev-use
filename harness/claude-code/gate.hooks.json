{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y github:716-Ventures/jev-use#main hook gate",
            "timeout": 30,
            "statusMessage": "Jev gate: risk-checking this action"
          }
        ]
      }
    ]
  }
}
